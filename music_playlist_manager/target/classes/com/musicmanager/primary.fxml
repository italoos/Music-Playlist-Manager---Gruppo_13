<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import com.musicmanager.MediaPlayerUI?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.musicmanager.controller.MainController">
   <children>
      <HBox prefHeight="40.0" spacing="10.0" style="-fx-padding: 10;">
         <children>

            <Button fx:id="addTrackButton"
                  mnemonicParsing="false"
                  onAction="#handleAddTrackButtonClick"
                  text="Aggiungi Brano" />

            <Button fx:id="addPlaylistButton"
                  mnemonicParsing="false"
                  onAction="#handleCreatePlaylist"
                  text="Crea Playlist" />

         </children>
      </HBox>
      <SplitPane dividerPositions="0.2505567928730512, 0.7505567928730512" focusTraversable="true" prefHeight="-1.0" prefWidth="-1.0" VBox.vgrow="ALWAYS">
         <items>
            <AnchorPane>
               <children>
                  <Label alignment="CENTER" layoutX="14.0" layoutY="14.0" minWidth="60.0" prefWidth="-1.0" style="&#10;" text="Tutti i brani" textAlignment="CENTER" wrapText="false">
                     <font>
                        <Font size="18.0" fx:id="x1" />
                     </font>
                     <textFill>
                        <Color red="0.624" green="0.624" blue="0.624" fx:id="x2" />
                     </textFill>
                  </Label>
                  <ListView fx:id="tracksListView" layoutX="14.0" layoutY="52.0" prefHeight="480.0" prefWidth="195.0" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="52.0" />
               </children>
            </AnchorPane>
            <ScrollPane prefHeight="-1.0" prefWidth="-1.0">
               <content>
                  <AnchorPane id="Content" minHeight="-1.0" minWidth="-1.0" prefHeight="545.0" prefWidth="430.0">
                     <children>
                        <Label alignment="CENTER" font="$x1" layoutX="14.0" layoutY="14.0" style="&#10;" text="View" textAlignment="CENTER" textFill="$x2" wrapText="false" />
                        <Text layoutX="189.0" layoutY="277.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Demo OK" />
                     </children>
                  </AnchorPane>
               </content>
            </ScrollPane>
            <AnchorPane>
               <children>

                  <Label fx:id="detailsTitleLabel"
                        layoutX="14.0"
                        layoutY="14.0"
                        text="Playlist"
                        textFill="$x2"
                        font="$x1"/>

                  <Button fx:id="backButton"
                        layoutX="14.0"
                        layoutY="50.0"
                        text="← Torna"
                        visible="false"
                        managed="false"
                        onAction="#handleBackToPlaylists"/>

                  <ListView fx:id="playlistListView"
                           layoutX="14.0"
                           layoutY="50.0"
                           prefHeight="480.0"
                           prefWidth="195.0"
                           AnchorPane.topAnchor="50.0"
                           AnchorPane.bottomAnchor="14.0"
                           AnchorPane.leftAnchor="14.0"
                           AnchorPane.rightAnchor="14.0"/>

                  <ListView fx:id="playlistTracksListView"
                           visible="false"
                           managed="false"
                           layoutX="14.0"
                           layoutY="90.0"
                           prefHeight="440.0"
                           prefWidth="195.0"
                           AnchorPane.topAnchor="90.0"
                           AnchorPane.bottomAnchor="14.0"
                           AnchorPane.leftAnchor="14.0"
                           AnchorPane.rightAnchor="14.0"/>

               </children>
            </AnchorPane>
         </items>
      </SplitPane>
      <MediaPlayerUI fx:id="mediaPlayerUI" VBox.vgrow="NEVER" />
   </children>
</VBox>

